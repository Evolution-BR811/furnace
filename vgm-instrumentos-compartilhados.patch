     };
+    // the period (or fnum<<block) Furnace writes for a pitch offset
+    auto periodAt=[&](int c, int off) -> int {
+      if (c>=12) {
+        int f=fwdOPLL.get(off,0,0);
+        if (f<0) f=0;
+        if (f>65535) f=65535;
+        int b;
+        if (curFixedBlock>0) {
+          b=curFixedBlock-1;
+        } else {
+          b=f/343;
+          if (b>0) b=bsr(b);
+          if (b>7) b=7;
+        }
+        int fn=f>>b;
+        if (fn>0x1ff) fn=0x1ff;
+        return fn<<b;
+      }
+      if (c>=8) {
+        int p;
+        if (off>snThr) {
+          p=((16<<7)-(off-snThr))>>7;
+        } else {
+          p=fwdSN.get(off,0,0);
+        }
+        if (p<0) p=0;
+        if (p>1023) p=1023;
+        return p;
+      }
+      if (c>=5) {
+        int p=fwd5B.get(off,0,0);
+        if (p<0) p=0;
+        if (p>4095) p=4095;
+        return p;
+      }
+      int p=pt.get(off,0,0)-1;
+      if (p<0) p=0;
+      if (p>2047) p=2047;
+      return p;
+    };
     auto tickNote=[&](int c, const VGMChanTick& t) -> int {
       return (tickOffset(c,t)+64)>>7;
     };
