From f9bc973e94602fe8ff51c6f46aee0cfdf09dd279 Mon Sep 17 00:00:00 2001
From: Evolution BR811 <344454957+Evolution-BR811@users.noreply.github.com>
Date: Mon, 9 Nov 2026 18:26:37 -0400
Subject: [PATCH] Macro +1/-1 buttons; "===" stops samples like OFF

- every macro (except bit macros) gets + and - buttons that move all of
  its steps by one value (a semitone on the arpeggio), next to the
  arpeggio octave buttons
- on sample channels (PCM channels, or a channel playing a sample
  instrument) the note release "===" cuts the note like OFF: a sample has
  no envelope to release, and MIDI imports write "===" for note offs

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KMJUrc1fn7dir5w2PfSPK2
---
 src/engine/playback.cpp          | 11 ++++++++++-
 src/gui/insEdit/insMacroEdit.cpp | 31 +++++++++++++++++++++++++++++++
 2 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/engine/playback.cpp b/src/engine/playback.cpp
index 4520ad9..a7a57e0 100644
--- a/src/engine/playback.cpp
+++ b/src/engine/playback.cpp
@@ -789,7 +789,16 @@ void DivEngine::processRow(int i, bool afterDelay) {
 
   // note reading
   // note offs are sent immediately
-  if (pat->newData[whatRow][DIV_PAT_NOTE]==DIV_NOTE_OFF) { // note off
+  // on sample channels "===" (note release) cuts the note like OFF: a sample
+  // has no envelope to release, and MIDI imports (OpenMPT) write "===" for
+  // every note off
+  // (a channel playing a sample instrument counts too, e.g. a DAC/PCM mode)
+  bool relIsOff=false;
+  if (pat->newData[whatRow][DIV_PAT_NOTE]==DIV_NOTE_REL) {
+    if (getChannelType(i)==DIV_CH_PCM) relIsOff=true;
+    if (chan[i].lastIns>=0 && chan[i].lastIns<(int)song.ins.size() && song.ins[chan[i].lastIns]->type==DIV_INS_AMIGA) relIsOff=true;
+  }
+  if (pat->newData[whatRow][DIV_PAT_NOTE]==DIV_NOTE_OFF || relIsOff) { // note off
     chan[i].keyOn=false;
     chan[i].keyOff=true;
 
diff --git a/src/gui/insEdit/insMacroEdit.cpp b/src/gui/insEdit/insMacroEdit.cpp
index 8e25510..f4de736 100644
--- a/src/gui/insEdit/insMacroEdit.cpp
+++ b/src/gui/insEdit/insMacroEdit.cpp
@@ -801,6 +801,34 @@ static bool shiftArpMacroOctave(DivInstrumentMacro* m, int semitones, int minVal
     } \
   }
 
+// sobe ou desce 1 valor (no arpejo, 1 semitom) em todos os passos de qualquer macro
+// (menos as de bits): so muda se todos os valores continuarem dentro de min..max
+static bool shiftMacroValues(DivInstrumentMacro* m, int delta, int minVal, int maxVal) {
+  for (int j=0; j<m->len; j++) {
+    if (m->val[j]+delta<minVal || m->val[j]+delta>maxVal) return false;
+  }
+  for (int j=0; j<m->len; j++) m->val[j]+=delta;
+  return true;
+}
+
+#define BUTTONS_FOR_MACRO_STEP(buttonType) \
+  if (!i.isBitfield && (i.macro->open&6)==0) { \
+    bool stepIsArp=(i.macro->macroType==DIV_MACRO_ARP || i.isArp); \
+    if (buttonType(ICON_FA_PLUS "##IMacroStepUp")) { \
+      if (stepIsArp?shiftArpMacroOctave(i.macro,1,i.min,i.max):shiftMacroValues(i.macro,1,i.min,i.max)) { MARK_MODIFIED; } \
+    } \
+    if (ImGui::IsItemHovered()) { \
+      ImGui::SetTooltip(stepIsArp?_("Arpeggio: one semitone up (+1 on every step)"):_("Macro: +1 on every step")); \
+    } \
+    ImGui::SameLine(); \
+    if (buttonType(ICON_FA_MINUS "##IMacroStepDown")) { \
+      if (stepIsArp?shiftArpMacroOctave(i.macro,-1,i.min,i.max):shiftMacroValues(i.macro,-1,i.min,i.max)) { MARK_MODIFIED; } \
+    } \
+    if (ImGui::IsItemHovered()) { \
+      ImGui::SetTooltip(stepIsArp?_("Arpeggio: one semitone down (-1 on every step)"):_("Macro: -1 on every step")); \
+    } \
+  }
+
 #define BUTTON_FOR_MACRO_MENU(buttonType) \
   if (mobileUI) { \
     if (buttonType(ICON_FA_PAGELINES "##IMacroMenu")) { \
@@ -899,6 +927,7 @@ void FurnaceGUI::drawMacros(std::vector<FurnaceGUIMacroDesc>& macros, FurnaceGUI
               BUTTON_TO_SET_RELEASE(ImGui::Button);
             }
             BUTTONS_FOR_ARP_OCTAVE(ImGui::Button);
+            BUTTONS_FOR_MACRO_STEP(ImGui::Button);
             BUTTON_FOR_MACRO_MENU(ImGui::Button);
             // do not change this!
             // anything other than a checkbox will look ugly!
@@ -991,6 +1020,7 @@ void FurnaceGUI::drawMacros(std::vector<FurnaceGUIMacroDesc>& macros, FurnaceGUI
               BUTTON_TO_SET_RELEASE(ImGui::Button);
             }
             BUTTONS_FOR_ARP_OCTAVE(ImGui::Button);
+            BUTTONS_FOR_MACRO_STEP(ImGui::Button);
             BUTTON_FOR_MACRO_MENU(ImGui::Button);
             if (i.modeName!=NULL) {
               bool modeVal=i.macro->mode;
@@ -1150,6 +1180,7 @@ void FurnaceGUI::drawMacros(std::vector<FurnaceGUIMacroDesc>& macros, FurnaceGUI
                   BUTTON_TO_SET_RELEASE(ImGui::Button);
                 }
                 BUTTONS_FOR_ARP_OCTAVE(ImGui::Button);
+                BUTTONS_FOR_MACRO_STEP(ImGui::Button);
                 BUTTON_FOR_MACRO_MENU(ImGui::Button);
               }
               if (m.modeName!=NULL) {
