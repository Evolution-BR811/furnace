From e979d5ba732264c6de207c04ef4340ed07c6d252 Mon Sep 17 00:00:00 2001
From: Evolution BR811 <344454957+Evolution-BR811@users.noreply.github.com>
Date: Mon, 9 Nov 2026 17:57:20 -0400
Subject: [PATCH] VGM/NSF import: no pitch macro where the period is the same
 without it

A pitch offset that writes the same period register as no offset at all
is dropped: the chip can't tell them apart, but each note used to get its
own pitch macro (and instrument) from it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KMJUrc1fn7dir5w2PfSPK2
---
 src/engine/fileOps/vgm.cpp | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/src/engine/fileOps/vgm.cpp b/src/engine/fileOps/vgm.cpp
index 34d02b4..60588a0 100644
--- a/src/engine/fileOps/vgm.cpp
+++ b/src/engine/fileOps/vgm.cpp
@@ -2454,6 +2454,17 @@ bool vgmConvertNES(VGMNESLog& log, VGMNESContext& ctx, DivSong& ds, DivSubSong*
           } else {
             vPitch.assign(vPitch.size(),0);
           }
+          // a pitch offset that writes the same period as none at all is no
+          // pitch offset: the period register can't tell them apart, so the
+          // instrument doesn't need it (each note would get its own otherwise)
+          if (c!=3 && c!=11 && c!=4 && c<21) {
+            for (size_t j=0; j<vPitch.size(); j++) {
+              if (vPitch[j]==0 || !ct[a+j].aud) continue;
+              int n=vArp[j]+segBase[j]+arpAdd[j];
+              int f=(segIdx[j]==0)?fine:legato[segIdx[j]-1][3];
+              if (periodAt(c,(n<<7)+f)==ct[a+j].period) vPitch[j]=0;
+            }
+          }
           // a vibrato that Furnace's own 04xy makes exactly (songs made in
           // Furnace) goes to the pattern instead of a pitch macro: try every
           // speed and depth, from the note's start or from a row start
-- 
