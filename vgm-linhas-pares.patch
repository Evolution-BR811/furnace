     std::vector<int> rowLen;
+    bool gridEven=false;
     {
       // anchor ticks and the channels that start a note there
       std::map<int,int> anchorMask;
@@ -1515,7 +1563,9 @@ bool vgmConvertNES(VGMNESLog& log, VGMNESContext& ctx, DivSong& ds, DivSubSong*
