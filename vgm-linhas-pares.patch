     logI("VGM import: %d note shapes, %d merged (%d notes), %d scaled matches, %d prefix matches",(int)sets.size(),mergedSets,mergedNotes,scaledMatches,prefixMatches);
+    ctx.mergedNotes+=mergedNotes;
     if (mergedSets>0) {
