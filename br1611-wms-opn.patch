+  while (i<t.size()) {
+    while (i<t.size() && !isalnum((unsigned char)t[i]) && t[i]!='$' && t[i]!='-') i++;
+    if (i>=t.size()) break;
+    bool hex=false;
+    if (t[i]=='$') {
+      hex=true;
+      i++;
+    } else if (t[i]=='0' && i+1<t.size() && (t[i+1]=='x' || t[i+1]=='X')) {
